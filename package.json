{
  "name": "syncboard-api",
  "version": "0.1.0",
  "description": "SyncBoard API — Express.js + TypeScript backend for a real-time collaborative Kanban board",
  "license": "GPL-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "seed": "tsx scripts/seed.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json && cp -r src/docs dist/docs",
    "start": "node dist/index.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest -c jest.config.js --passWithNoTests && NODE_OPTIONS=--experimental-vm-modules jest -c jest.integration.config.js --passWithNoTests",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest -c jest.config.js --passWithNoTests",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest -c jest.integration.config.js --passWithNoTests",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest -c jest.config.js --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest -c jest.config.js --coverage --passWithNoTests && NODE_OPTIONS=--experimental-vm-modules jest -c jest.integration.config.js --coverage --passWithNoTests",
    "test:unit:coverage": "NODE_OPTIONS=--experimental-vm-modules jest -c jest.config.js --coverage --passWithNoTests",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^4.0.0",
    "socket.io": "^4.7.5",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.14.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.5.0",
    "@types/passport": "^1.0.16",
    "@types/passport-jwt": "^4.0.1",
    "@types/react": "^18.3.4",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.6",
    "eslint": "^9.9.1",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.5",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.3.0"
  }
}
